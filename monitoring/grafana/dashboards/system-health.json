{
  "uid": "system-health",
  "title": "System Health Dashboard",
  "description": "CPU, Memory, and Uptime for all platform services",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up, job)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Service Uptime & Availability",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Services Up",
      "description": "Number of services currently responding to Prometheus scrapes",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "green", "value": 6 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=~\"$job\"} == 1)",
          "legendFormat": "Up"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Services Down",
      "description": "Number of services failing Prometheus scrapes",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=~\"$job\"} == 0) or vector(0)",
          "legendFormat": "Down"
        }
      ]
    },
    {
      "type": "table",
      "title": "Container Uptime",
      "description": "How long each service process has been running",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "align": "left" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "job" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Uptime" },
              { "id": "unit", "value": "dtdurations" }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - process_start_time_seconds{job=~\"$job\"}",
          "legendFormat": "{{job}}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "CPU Usage",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "CPU Usage Rate by Service",
      "description": "Rate of CPU seconds consumed per second (1.0 = 100% of one core)",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=~\"$job\"}[1m])",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Current CPU Usage per Service",
      "description": "Instantaneous CPU usage rate",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 0.8 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=~\"$job\"}[1m])",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Memory Usage",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Resident Memory (RSS) by Service",
      "description": "Physical memory used by each service process",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Current Memory per Service",
      "description": "Current RSS memory usage",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 134217728 },
              { "color": "red", "value": 268435456 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Virtual Memory & File Descriptors",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Virtual Memory (VSZ) by Service",
      "description": "Virtual memory allocated to each service",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_virtual_memory_bytes{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Open File Descriptors by Service",
      "description": "Number of open file descriptors per service (high values may indicate resource leaks)",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 900 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_open_fds{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "B",
          "expr": "process_max_fds{job=~\"$job\"}",
          "legendFormat": "{{job}} (max)"
        }
      ]
    },
    {
      "type": "row",
      "title": "HTTP Request Performance",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Rate by Service",
      "description": "Requests per second across all services",
      "gridPos": { "x": 0, "y": 33, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_requests_total{job=~\"$job\"}[1m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Error Rate (4xx + 5xx)",
      "description": "Rate of error responses per service",
      "gridPos": { "x": 12, "y": 33, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_requests_total{job=~\"$job\", status=~\"4..|5..\"}[1m]))",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}

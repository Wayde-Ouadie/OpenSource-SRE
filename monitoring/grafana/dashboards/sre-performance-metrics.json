{
  "uid": "sre-performance-metrics",
  "title": "SRE Performance Metrics (Skeleton)",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "MTTA p50/p95 (seconds)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(incident_mtta_seconds_bucket[5m])) by (le))"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(incident_mtta_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MTTR p50/p95 (seconds)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(incident_mttr_seconds_bucket[5m])) by (le))"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(incident_mttr_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Escalations (rate)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (team) (rate(escalations_total[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Notifications Sent (rate)",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel) (rate(oncall_notifications_sent_total[5m]))"
        }
      ]
    }
  ]
}

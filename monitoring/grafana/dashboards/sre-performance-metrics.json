{
  "uid": "sre-performance-metrics",
  "title": "SRE Performance Metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "MTTA Trend – p50 / p95 (seconds)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(incident_mtta_seconds_bucket[30m])) by (le))",
          "legendFormat": "p50 MTTA"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(incident_mtta_seconds_bucket[30m])) by (le))",
          "legendFormat": "p95 MTTA"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MTTR Trend – p50 / p95 (seconds)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(incident_mttr_seconds_bucket[30m])) by (le))",
          "legendFormat": "p50 MTTR"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(incident_mttr_seconds_bucket[30m])) by (le))",
          "legendFormat": "p95 MTTR"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Incident Volume by Service",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (service) (incidents_total))",
          "legendFormat": "{{service}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "type": "histogram",
      "title": "Acknowledgment Time Distribution",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(incident_mtta_seconds_bucket[24h])) by (le)",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ]
    },
    {
      "type": "histogram",
      "title": "Resolution Time Distribution",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(incident_mttr_seconds_bucket[24h])) by (le)",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Escalations by Team",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (team) (rate(escalations_total[5m]))",
          "legendFormat": "{{team}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Notifications Sent by Channel",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel) (rate(oncall_notifications_sent_total[5m]))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Incidents",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(incidents_total) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Alerts",
      "gridPos": {
        "x": 18,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(alerts_received_total) or vector(0)"
        }
      ]
    }
  ]
}